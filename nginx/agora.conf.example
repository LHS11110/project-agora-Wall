# Single Nginx configuration, owned by project-agora-Wall.
# Mounted as /etc/nginx/templates/default.conf.template by the Nginx Compose.
# Docker substitutes FRONTEND_MODE and NGINX_HTTPS_PORT at startup.
include /etc/nginx/routes/cpp-routes.conf;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
map "${FRONTEND_MODE}" $frontend_root {
    default /usr/share/nginx/html/current;
    development /var/empty/agora;
}
map "${FRONTEND_MODE}" $spa_fallback {
    default /index.html;
    development @vite;
}
map "${FRONTEND_MODE}" $asset_cache {
    default "public, max-age=31536000, immutable";
    development "no-cache";
}
map "${FRONTEND_MODE}" $vite_enabled {
    default 0;
    development 1;
}

# Do not force HTTPS onto other localhost development ports through HSTS.
map $host $agora_hsts {
    default "max-age=31536000";
    localhost "max-age=0";
    127.0.0.1 "max-age=0";
}

server {
    server_tokens off;
    listen 443 ssl;
    # Restore client IP only from the explicitly trusted outer reverse proxy.
    set_real_ip_from ${NGINX_TRUSTED_PROXY_IP};
    real_ip_header X-Real-IP;
    server_name _;
    resolver 127.0.0.11 valid=30s ipv6=off;
    proxy_ssl_trusted_certificate /etc/nginx/ssl/agora/ca.pem;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.3;
    root $frontend_root;
    index index.html;

    ssl_certificate /etc/nginx/ssl/agora/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agora/privkey.pem;
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:AgoraTLS:10m;
    ssl_session_timeout 1h;
    # Local certificates cover localhost and loopback only. Public deployments
    # must supply their domain's CA-issued fullchain/key using the same mounts.
    add_header Strict-Transport-Security $agora_hsts always;
    add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Internal application routes are never served on the published listener.
    location /internal/ { return 404; }

    location /api/ {
        proxy_hide_header Strict-Transport-Security;
        set $spring_host agora-spring;
        proxy_ssl_name agora-spring;
        proxy_pass https://$spring_host:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port ${NGINX_HTTPS_PORT};
    }

    # Logical C++ route ports are resolved by the broker allowlist.
    location ~ ^/wss/port/(?<cpp_ws_port>80(?:0[2-9]|[1-9][0-9]))/(?<broker_channel>(?:rtc/)?canvas)/(?<broker_canvas_id>[0-9]+)$ {
        set $broker_host agora-broker;
        set $broker_rtc false;
        if ($broker_channel = "rtc/canvas") { set $broker_rtc true; }
        proxy_ssl_name ${BROKER_TLS_SERVER_NAME};
        proxy_pass https://$broker_host:4443/broker/websocket?canvas_id=$broker_canvas_id&ws_port=$cpp_ws_port&rtc=$broker_rtc&token=$arg_token;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        access_log off;
    }
    location /wss/ { return 404; }

    location = /index.html {
        try_files $uri @vite;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location /assets/ {
        try_files $uri @vite;
        add_header Cache-Control $asset_cache;
        add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location ~ \.mjs$ {
        try_files $uri @vite;
        types { application/javascript mjs; }
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location /pdfjs/ {
        try_files $uri @vite;
        types {
            application/wasm wasm;
            application/javascript js mjs;
            application/json json;
        }
        default_type application/octet-stream;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location /mathjax/ {
        try_files $uri @vite;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "connect-src https: wss:; img-src https: data: blob:; media-src https: blob: data:; frame-src https:" always;
    add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location / {
        try_files $uri $uri/ $spa_fallback;
    }
    location @vite {
        # A missing production asset must not return the SPA HTML.
        if ($vite_enabled = 0) { return 404; }
        set $vite_host agora-frontend-dev;
        proxy_ssl_name agora-frontend-dev;
        proxy_pass https://$vite_host:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port ${NGINX_HTTPS_PORT};
        proxy_read_timeout 86400s;
    }
}

# Docker-internal listener only; do not publish this port to browsers.
server {
    listen 8444 ssl;
    server_name _;
    server_tokens off;
    resolver 127.0.0.11 valid=30s ipv6=off;
    ssl_certificate /etc/nginx/ssl/agora/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agora/privkey.pem;
    ssl_protocols TLSv1.3;
    proxy_ssl_trusted_certificate /etc/nginx/ssl/agora/ca.pem;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.3;
    location = /internal/search/embedding {
        set $embedding_host agora-search-embedding;
        proxy_ssl_name agora-spring;
        proxy_pass https://$embedding_host:8445/embed;
        proxy_set_header X-Agora-Internal-Token $http_x_agora_internal_token;
        proxy_set_header Host agora-spring;
        proxy_connect_timeout 1s;
        proxy_read_timeout 3s;
        client_max_body_size 64k;
        access_log off;
    }
    location ~ ^/internal/cpp/servers/(?<cpp_server_id>[1-9][0-9]*)/(?<cpp_api_path>api/.*|health)$ {
        if ($cpp_api_upstream = "") { return 404; }
        if ($cpp_api_tls_name = "") { return 404; }
        proxy_ssl_name $cpp_api_tls_name;
        proxy_pass https://$cpp_api_upstream/$cpp_api_path$is_args$args;
        proxy_set_header Host $cpp_api_tls_name;
        proxy_set_header X-Agora-Internal-Token $http_x_agora_internal_token;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
        proxy_redirect off;
    }
    location / { return 404; }
}
