# Certificates are manually supplied; setup.py records an absolute path.
NGINX_TLS_CERT_DIR=
NGINX_HTTPS_PORT=8443
NGINX_BACKEND_IP=172.23.0.250
FRONTEND_MODE=production

# Filled by setup.py; shared internal token must match BE.
CPP_INTERNAL_API_TOKEN=
BROKER_SECRET_KEY_BASE=
BROKER_CPP_TARGETS='{"8002":"wss://agora-cpp:8002"}'
BROKER_TLS_CERT_DIR=
BROKER_TLS_SERVER_NAME=agora-broker
BROKER_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# Shared with Spring only; never passed to C++.
JWT_SECRET=
# Optional logical WS port -> registered C++ advertised hostname (serverHash).
BROKER_CPP_IDENTITIES=

# Wall creates an isolated service network; storage networks are separate.
AGORA_SERVICES_SUBNET=172.23.0.0/16
STORAGE_MSSQL_UPSTREAM=mssql:1433
STORAGE_ES_UPSTREAM=elasticsearch:9200
STORAGE_REDIS_PRIMARY_UPSTREAM=172.20.0.2:6379
STORAGE_REDIS_REPLICA_1_UPSTREAM=172.20.0.7:6379
STORAGE_REDIS_REPLICA_2_UPSTREAM=172.20.0.5:6379
STORAGE_SENTINEL_1_UPSTREAM=172.20.0.6:26379
STORAGE_SENTINEL_2_UPSTREAM=172.20.0.3:26379
STORAGE_SENTINEL_3_UPSTREAM=172.20.0.4:26379
